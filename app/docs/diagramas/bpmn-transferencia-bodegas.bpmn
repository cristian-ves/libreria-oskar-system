<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_transferencia_bodegas" targetNamespace="https://libreria-oskar.example/procesos/futuros">
  <bpmn:process id="Process_transferencia_bodegas" name="BPMN 01 · Transferencia de libros entre bodegas (propuesta futura)" isExecutable="false">
    <bpmn:documentation>Flujo futuro. El despacho y la recepción son transacciones separadas con seguimiento; no se afirma que exista una transferencia atómica durante el transporte.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_transferencia_bodegas">
      <bpmn:lane id="Lane_transferencia_bodegas_0" name="Operador de origen">
        <bpmn:flowNodeRef>Node_transferencia_bodegas_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_aut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_cer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_transferencia_bodegas_1" name="Sistema / PostgreSQL">
        <bpmn:flowNodeRef>Node_transferencia_bodegas_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_sal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_ent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_transferencia_bodegas_2" name="Encargado de destino">
        <bpmn:flowNodeRef>Node_transferencia_bodegas_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_fno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transferencia_bodegas_rec</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_transferencia_bodegas_i" name="Necesidad de traslado">
      <bpmn:outgoing>Flow_transferencia_bodegas_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Node_transferencia_bodegas_sol" name="Registrar solicitud origen / destino / cantidad">
      <bpmn:incoming>Flow_transferencia_bodegas_0</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_transferencia_bodegas_val" name="Validar sedes y existencias disponibles">
      <bpmn:incoming>Flow_transferencia_bodegas_1</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_transferencia_bodegas_g1" name="¿Solicitud válida?">
      <bpmn:incoming>Flow_transferencia_bodegas_2</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_transferencia_bodegas_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_transferencia_bodegas_rej" name="Informar rechazo sin alterar existencias">
      <bpmn:incoming>Flow_transferencia_bodegas_3</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_transferencia_bodegas_fno" name="Solicitud rechazada">
      <bpmn:incoming>Flow_transferencia_bodegas_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Node_transferencia_bodegas_aut" name="Autorizar traslado y responsable">
      <bpmn:incoming>Flow_transferencia_bodegas_5</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_transferencia_bodegas_sal" name="Despachar: salida auditada en Kardex">
      <bpmn:incoming>Flow_transferencia_bodegas_6</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_transferencia_bodegas_rec" name="Confirmar recepción en destino">
      <bpmn:incoming>Flow_transferencia_bodegas_7</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_transferencia_bodegas_ent" name="Registrar ingreso idempotente en Kardex">
      <bpmn:incoming>Flow_transferencia_bodegas_8</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_transferencia_bodegas_cer" name="Cerrar traslado y consultar seguimiento">
      <bpmn:incoming>Flow_transferencia_bodegas_9</bpmn:incoming>
      <bpmn:outgoing>Flow_transferencia_bodegas_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_transferencia_bodegas_fin" name="Traslado completado">
      <bpmn:incoming>Flow_transferencia_bodegas_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_0" sourceRef="Node_transferencia_bodegas_i" targetRef="Node_transferencia_bodegas_sol"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_1" sourceRef="Node_transferencia_bodegas_sol" targetRef="Node_transferencia_bodegas_val"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_2" sourceRef="Node_transferencia_bodegas_val" targetRef="Node_transferencia_bodegas_g1"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_3" sourceRef="Node_transferencia_bodegas_g1" targetRef="Node_transferencia_bodegas_rej" name="No"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_4" sourceRef="Node_transferencia_bodegas_rej" targetRef="Node_transferencia_bodegas_fno"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_5" sourceRef="Node_transferencia_bodegas_g1" targetRef="Node_transferencia_bodegas_aut" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_6" sourceRef="Node_transferencia_bodegas_aut" targetRef="Node_transferencia_bodegas_sal"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_7" sourceRef="Node_transferencia_bodegas_sal" targetRef="Node_transferencia_bodegas_rec"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_8" sourceRef="Node_transferencia_bodegas_rec" targetRef="Node_transferencia_bodegas_ent"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_9" sourceRef="Node_transferencia_bodegas_ent" targetRef="Node_transferencia_bodegas_cer"/>
    <bpmn:sequenceFlow id="Flow_transferencia_bodegas_10" sourceRef="Node_transferencia_bodegas_cer" targetRef="Node_transferencia_bodegas_fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_transferencia_bodegas">
    <bpmndi:BPMNPlane id="Plane_transferencia_bodegas" bpmnElement="Process_transferencia_bodegas">
      <bpmndi:BPMNShape id="LaneShape_transferencia_bodegas_0" bpmnElement="Lane_transferencia_bodegas_0" isHorizontal="true">
