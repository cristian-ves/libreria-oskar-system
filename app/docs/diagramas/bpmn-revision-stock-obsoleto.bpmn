<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_revision_stock_obsoleto" targetNamespace="https://libreria-oskar.example/procesos/futuros">
  <bpmn:process id="Process_revision_stock_obsoleto" name="BPMN 02 · Revisión periódica de stock obsoleto (evolución propuesta)" isExecutable="false">
    <bpmn:documentation>Reporte, ajuste de precio y salida auditada tienen bases funcionales existentes en la rama de stock obsoleto; evaluación y aviso periódico son ampliaciones futuras.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_revision_stock_obsoleto">
      <bpmn:lane id="Lane_revision_stock_obsoleto_0" name="Motor / tarea programada">
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_pre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_revision_stock_obsoleto_1" name="Administrador">
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_cerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_revision_stock_obsoleto_2" name="Inventario / Kardex">
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_fno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_baj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revision_stock_obsoleto_aud</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_revision_stock_obsoleto_i" name="Evaluación programada">
      <bpmn:outgoing>Flow_revision_stock_obsoleto_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Node_revision_stock_obsoleto_cal" name="Calcular rotación por libro y bodega">
      <bpmn:incoming>Flow_revision_stock_obsoleto_0</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_revision_stock_obsoleto_g1" name="¿Hay libros sin ventas?">
      <bpmn:incoming>Flow_revision_stock_obsoleto_1</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_revision_stock_obsoleto_no" name="Registrar resultado sin candidatos">
      <bpmn:incoming>Flow_revision_stock_obsoleto_2</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_revision_stock_obsoleto_fno" name="Evaluación finalizada">
      <bpmn:incoming>Flow_revision_stock_obsoleto_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Node_revision_stock_obsoleto_rep" name="Crear reporte y aviso idempotente">
      <bpmn:incoming>Flow_revision_stock_obsoleto_4</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_revision_stock_obsoleto_rev" name="Revisar existencias y contexto comercial">
      <bpmn:incoming>Flow_revision_stock_obsoleto_5</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_revision_stock_obsoleto_g2" name="¿Qué acción?">
      <bpmn:incoming>Flow_revision_stock_obsoleto_6</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_revision_stock_obsoleto_pre" name="Actualizar precio global del libro">
      <bpmn:incoming>Flow_revision_stock_obsoleto_7</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_revision_stock_obsoleto_baj" name="Registrar salida con motivo">
      <bpmn:incoming>Flow_revision_stock_obsoleto_8</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_revision_stock_obsoleto_aud" name="Conservar historial y responsable">
      <bpmn:incoming>Flow_revision_stock_obsoleto_10</bpmn:incoming>
      <bpmn:incoming>Flow_revision_stock_obsoleto_11</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_revision_stock_obsoleto_cerr" name="Verificar resultado y seguimiento">
      <bpmn:incoming>Flow_revision_stock_obsoleto_9</bpmn:incoming>
      <bpmn:incoming>Flow_revision_stock_obsoleto_12</bpmn:incoming>
      <bpmn:outgoing>Flow_revision_stock_obsoleto_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_revision_stock_obsoleto_fin" name="Revisión concluida">
      <bpmn:incoming>Flow_revision_stock_obsoleto_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_0" sourceRef="Node_revision_stock_obsoleto_i" targetRef="Node_revision_stock_obsoleto_cal"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_1" sourceRef="Node_revision_stock_obsoleto_cal" targetRef="Node_revision_stock_obsoleto_g1"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_2" sourceRef="Node_revision_stock_obsoleto_g1" targetRef="Node_revision_stock_obsoleto_no" name="No"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_3" sourceRef="Node_revision_stock_obsoleto_no" targetRef="Node_revision_stock_obsoleto_fno"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_4" sourceRef="Node_revision_stock_obsoleto_g1" targetRef="Node_revision_stock_obsoleto_rep" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_5" sourceRef="Node_revision_stock_obsoleto_rep" targetRef="Node_revision_stock_obsoleto_rev"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_6" sourceRef="Node_revision_stock_obsoleto_rev" targetRef="Node_revision_stock_obsoleto_g2"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_7" sourceRef="Node_revision_stock_obsoleto_g2" targetRef="Node_revision_stock_obsoleto_pre" name="Precio"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_8" sourceRef="Node_revision_stock_obsoleto_g2" targetRef="Node_revision_stock_obsoleto_baj" name="Baja"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_9" sourceRef="Node_revision_stock_obsoleto_g2" targetRef="Node_revision_stock_obsoleto_cerr" name="Sin acción"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_10" sourceRef="Node_revision_stock_obsoleto_pre" targetRef="Node_revision_stock_obsoleto_aud"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_11" sourceRef="Node_revision_stock_obsoleto_baj" targetRef="Node_revision_stock_obsoleto_aud"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_12" sourceRef="Node_revision_stock_obsoleto_aud" targetRef="Node_revision_stock_obsoleto_cerr"/>
    <bpmn:sequenceFlow id="Flow_revision_stock_obsoleto_13" sourceRef="Node_revision_stock_obsoleto_cerr" targetRef="Node_revision_stock_obsoleto_fin"/>
  </bpmn:process>
