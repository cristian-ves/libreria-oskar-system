      <bpmndi:BPMNEdge id="Edge_reposicion_asistida_0" bpmnElement="Flow_reposicion_asistida_0">
        <di:waypoint x="542" y="185"/>
        <di:waypoint x="690" y="185"/>
      </bpmndi:BPMNEdge>
