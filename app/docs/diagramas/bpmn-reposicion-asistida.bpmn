        <dc:Bounds x="2520" y="578" width="250" height="94"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reposicion_asistida_reg" bpmnElement="Node_reposicion_asistida_reg">
        <dc:Bounds x="2825" y="138" width="250" height="94"/>
