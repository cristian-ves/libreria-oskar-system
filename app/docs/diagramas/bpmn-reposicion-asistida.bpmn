<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_reposicion_asistida" targetNamespace="https://libreria-oskar.example/procesos/futuros">
  <bpmn:process id="Process_reposicion_asistida" name="BPMN 03 · Reposición asistida y recepción de pedido (propuesta futura)" isExecutable="false">
    <bpmn:documentation>Proceso futuro: las órdenes, proveedores y recepciones documentadas requieren nueva estructura de datos. No existe hoy compra automatizada.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_reposicion_asistida">
      <bpmn:lane id="Lane_reposicion_asistida_0" name="Motor de análisis">
        <bpmn:flowNodeRef>Node_reposicion_asistida_i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_met</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_ord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reposicion_asistida_1" name="Administrador">
        <bpmn:flowNodeRef>Node_reposicion_asistida_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_fno2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reposicion_asistida_2" name="Almacén">
        <bpmn:flowNodeRef>Node_reposicion_asistida_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_fno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_reposicion_asistida_rec</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_reposicion_asistida_i" name="Revisión de abastecimiento">
      <bpmn:outgoing>Flow_reposicion_asistida_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Node_reposicion_asistida_met" name="Combinar ventas, existencias y mínimos">
      <bpmn:incoming>Flow_reposicion_asistida_0</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_reposicion_asistida_cal" name="Sugerir cantidades con datos disponibles">
      <bpmn:incoming>Flow_reposicion_asistida_1</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_reposicion_asistida_g1" name="¿Se requiere reposición?">
      <bpmn:incoming>Flow_reposicion_asistida_2</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_reposicion_asistida_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_reposicion_asistida_no" name="Conservar nivel sin propuesta">
      <bpmn:incoming>Flow_reposicion_asistida_3</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_reposicion_asistida_fno" name="Sin pedido generado">
      <bpmn:incoming>Flow_reposicion_asistida_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Node_reposicion_asistida_rev" name="Revisar propuesta y proveedor">
      <bpmn:incoming>Flow_reposicion_asistida_5</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_reposicion_asistida_g2" name="¿Aprobar pedido?">
      <bpmn:incoming>Flow_reposicion_asistida_6</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_reposicion_asistida_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_reposicion_asistida_rej" name="Registrar rechazo con motivo">
      <bpmn:incoming>Flow_reposicion_asistida_7</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_reposicion_asistida_fno2" name="Pedido no aprobado">
      <bpmn:incoming>Flow_reposicion_asistida_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Node_reposicion_asistida_ord" name="Emitir orden de compra identificada">
      <bpmn:incoming>Flow_reposicion_asistida_9</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_reposicion_asistida_rec" name="Cotejar entrega y cantidades">
      <bpmn:incoming>Flow_reposicion_asistida_10</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Node_reposicion_asistida_reg" name="Registrar ingreso y actualizar Kardex">
      <bpmn:incoming>Flow_reposicion_asistida_11</bpmn:incoming>
      <bpmn:outgoing>Flow_reposicion_asistida_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_reposicion_asistida_fin" name="Recepción contabilizada">
      <bpmn:incoming>Flow_reposicion_asistida_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_0" sourceRef="Node_reposicion_asistida_i" targetRef="Node_reposicion_asistida_met"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_1" sourceRef="Node_reposicion_asistida_met" targetRef="Node_reposicion_asistida_cal"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_2" sourceRef="Node_reposicion_asistida_cal" targetRef="Node_reposicion_asistida_g1"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_3" sourceRef="Node_reposicion_asistida_g1" targetRef="Node_reposicion_asistida_no" name="No"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_4" sourceRef="Node_reposicion_asistida_no" targetRef="Node_reposicion_asistida_fno"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_5" sourceRef="Node_reposicion_asistida_g1" targetRef="Node_reposicion_asistida_rev" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_6" sourceRef="Node_reposicion_asistida_rev" targetRef="Node_reposicion_asistida_g2"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_7" sourceRef="Node_reposicion_asistida_g2" targetRef="Node_reposicion_asistida_rej" name="No"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_8" sourceRef="Node_reposicion_asistida_rej" targetRef="Node_reposicion_asistida_fno2"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_9" sourceRef="Node_reposicion_asistida_g2" targetRef="Node_reposicion_asistida_ord" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_10" sourceRef="Node_reposicion_asistida_ord" targetRef="Node_reposicion_asistida_rec"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_11" sourceRef="Node_reposicion_asistida_rec" targetRef="Node_reposicion_asistida_reg"/>
    <bpmn:sequenceFlow id="Flow_reposicion_asistida_12" sourceRef="Node_reposicion_asistida_reg" targetRef="Node_reposicion_asistida_fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_reposicion_asistida">
    <bpmndi:BPMNPlane id="Plane_reposicion_asistida" bpmnElement="Process_reposicion_asistida">
      <bpmndi:BPMNShape id="LaneShape_reposicion_asistida_0" bpmnElement="Lane_reposicion_asistida_0" isHorizontal="true">
        <dc:Bounds x="65" y="85" width="3290" height="195"/>
      </bpmndi:BPMNShape>
