      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reposicion_asistida_fno" bpmnElement="Node_reposicion_asistida_fno">
        <dc:Bounds x="2003" y="593" width="64" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reposicion_asistida_rev" bpmnElement="Node_reposicion_asistida_rev">
        <dc:Bounds x="1605" y="358" width="250" height="94"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reposicion_asistida_g2" bpmnElement="Node_reposicion_asistida_g2">
        <dc:Bounds x="2003" y="373" width="64" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reposicion_asistida_rej" bpmnElement="Node_reposicion_asistida_rej">
        <dc:Bounds x="2215" y="358" width="250" height="94"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reposicion_asistida_fno2" bpmnElement="Node_reposicion_asistida_fno2">
        <dc:Bounds x="2613" y="373" width="64" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_reposicion_asistida_ord" bpmnElement="Node_reposicion_asistida_ord">
        <dc:Bounds x="2215" y="138" width="250" height="94"/>
      </bpmndi:BPMNShape>
