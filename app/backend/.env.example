# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=libreria_oskar
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/libreria_oskar

# Base independiente usada exclusivamente por `npm test`.
TEST_DB_HOST=localhost
TEST_DB_PORT=5435
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Google Books API (Opcional, para aumentar cuotas de consulta)
GOOGLE_BOOKS_API_KEY=

# Autenticación JWT
JWT_SECRET=secreto-solo-para-desarrollo-local
JWT_EXPIRES_IN=8h
