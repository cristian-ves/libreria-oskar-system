# Configuración del Servidor
PORT=3000
NODE_ENV=development

# CORS: lista de orígenes separados por coma. En producción es obligatoria.
CORS_ORIGINS=http://localhost:5173
# Saltos de proxy confiables. 0 es seguro hasta definir la topología real.
TRUST_PROXY=0
# Protección de POST /api/auth/login (por IP).
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=900000

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=libreria_oskar
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/libreria_oskar

# Base independiente usada exclusivamente por `npm test`.
TEST_DB_HOST=localhost
TEST_DB_PORT=5435
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Google Books API (Opcional, para aumentar cuotas de consulta)
GOOGLE_BOOKS_API_KEY=

# Autenticación JWT
JWT_SECRET=secreto-solo-para-desarrollo-local
JWT_EXPIRES_IN=8h

# Verificación en dos pasos (TOTP). Con NODE_ENV=test siempre está apagada.
# TWO_FACTOR_ENFORCED: true|false; por defecto true en producción y false en los demás entornos.
# TWO_FACTOR_ENCRYPTION_KEY: 64 caracteres hexadecimales (32 bytes); obligatoria en producción.
# Genere una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde o cambia, los secretos guardados dejan de descifrarse y cada usuario debe restablecer su 2FA.
TWO_FACTOR_ENFORCED=false
TWO_FACTOR_ENCRYPTION_KEY=

# Correo saliente (proveedor: smtp | consola). Con NODE_ENV=test siempre es consola.
# Por defecto: smtp en producción, consola en los demás entornos.
# Con Gmail use una contraseña de aplicación, no la contraseña de la cuenta.
MAIL_PROVIDER=consola
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Remitente; si falta se usa MAIL_USER
MAIL_FROM=
